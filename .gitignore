## =========================================================================
## .gitignore para Hackthon (.NET 8 / C# / EF Core)
## =========================================================================

# Build and output directories
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.userprefs
*.sln.docstates

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# JetBrains (Rider, ReSharper)
.idea/
*.sln.iml
_ReSharper*/

# User-specific & local configuration files
*.local.json
appsettings.*.local.json
appsettings.local.json
.env
*.env.*
!.env.example

# Compilation and publish outputs
[Dd]ebug/
[Rr]elease/
publish/
*.nupkg
*.snupkg
*.nuget.props
*.nuget.targets
project.lock.json
project.fragment.lock.json

# Test results and coverage
TestResults/
coverage/
*.coverage
*.coveragexml

# Crash dumps and memory profiling
*.stackdump
*.dump
*.crash
*.dmp

# OS-specific files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Storage / Uploads
uploads/
scratch/
