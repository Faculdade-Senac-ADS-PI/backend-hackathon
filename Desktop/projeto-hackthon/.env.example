# ============================================================
# Hackathon — variáveis de ambiente do Docker Compose
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ============================================================

# Chave do provedor de IA (Google Gemini, endpoint compatível OpenAI).
# Usada na avaliação dos projetos e na ingestão/consulta da base de normas (RAG).
# Sem chave, a API usa o analisador heurístico (o RAG não gera embeddings).
AGENTE_IA_API_KEY=

# Modelo de chat (opcional). Padrão: gemini-3.5-flash.
# AGENTE_IA_MODELO=gemini-3.5-flash
